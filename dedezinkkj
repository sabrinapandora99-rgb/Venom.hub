    if laggerToggled and laggerPhase == 1 then return tonumber(LAGGER_SPEED) or 29 end
    if laggerToggled and laggerPhase == 2 then return tonumber(LAGGER_CARRY_SPEED) or 15 end
    if speedMode then return tonumber(CS) or 28.8 end
    return tonumber(NS) or 59.5
end

