local function findNearestPrompt()
    local char = LP.Character
    if not char then return nil, nil, nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil, nil, nil end
    
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil, nil, nil end
    
    local nearestPrompt, nearestDist, nearestName = nil, math.huge, nil
    
    for _, plot in ipairs(plots:GetChildren()) do
        if isMyPlotByName(plot.Name) then continue end
        
        local pods = plot:FindFirstChild("AnimalPodiums")
        if not pods then continue end
        
        for _, pod in ipairs(pods:GetChildren()) do
            pcall(function()
                local base = pod:FindFirstChild("Base")
                local spawn = base and base:FindFirstChild("Spawn")
                if spawn then
                    local dist = (spawn.Position - root.Position).Magnitude
                    if dist < nearestDist and dist <= Steal.StealRadius then
                        local att = spawn:FindFirstChild("PromptAttachment")
                        if att then
                            for _, child in ipairs(att:GetChildren()) do
                                if child:IsA("ProximityPrompt") and child.ActionText and child.ActionText:find("Steal") then
                                    nearestPrompt, nearestDist, nearestName = child, dist, pod.Name
                                    break
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
    
    return nearestPrompt, nearestDist, nearestName
end

-- AUTO GRAB SEMI (portado do MysteryDuels): pre-carrega ate Stop %,
-- espera entrar no Delay Radius, completa a barra e dispara o prompt.
local function setBar(p)
    if progressFill then progressFill.Size = UDim2.new(math.clamp(p,0,1), 0, 1, 0) end
    if progressPct then progressPct.Text = math.floor(math.clamp(p,0,1) * 100) .. "%" end
end
local lastStealResult = 0
local function executeSteal(prompt, podName)
    if isStealing or not prompt or not prompt.Parent then return end
    if tick() - lastStealResult < 0.05 then return end
    if not Steal.Data[prompt] then
        local d = {hold = {}, trigger = {}, ready = true}
        pcall(function()
            if getconnections then
                for _, c in ipairs(getconnections(prompt.PromptButtonHoldBegan)) do
                    if type(c.Function)=="function" then table.insert(d.hold, c.Function) end
                end
                for _, c in ipairs(getconnections(prompt.Triggered)) do
                    if type(c.Function)=="function" then table.insert(d.trigger, c.Function) end
                end
            end
        end)
        Steal.Data[prompt] = d
    end
    local data = Steal.Data[prompt]
    if not data.ready then return end
    data.ready = false
    isStealing = true
    if barResetTween then barResetTween:Cancel(); barResetTween = nil end
    if progressFill then progressFill.BackgroundColor3 = Color3.fromRGB(255, 45, 45) end
    setBar(0)

    task.spawn(function()
        local function root()
            local c = LP.Character; return c and c:FindFirstChild("HumanoidRootPart")
        end
        local startTime = tick()
        local duration = math.max(tonumber(Steal.StealDuration) or 1.3, 0.05)
        local pct = math.clamp(tonumber(autoGrabStopPercent) or 75, 1, 100)
        local stopTime = duration * (pct / 100)
        local cancelled = false

        for _, fn in ipairs(data.hold) do task.spawn(function() pcall(fn) end) end

        -- Fase 1: carrega ate Stop %
        while Steal.AutoStealEnabled do
            local elapsed = tick() - startTime
            if elapsed >= stopTime then break end
            setBar(elapsed / duration)
            local r = root()
            if not r or not prompt.Parent or not prompt.Parent.Parent then cancelled = true; break end
            if (r.Position - prompt.Parent.Parent.Position).Magnitude > Steal.StealRadius then cancelled = true; break end
            task.wait()
        end
        if not Steal.AutoStealEnabled then cancelled = true end

        local stopProgress = math.clamp(stopTime / duration, 0, 1)
        if not cancelled then setBar(stopProgress) end
        local phase2Timeout = math.max(2.99 - stopTime - math.max(duration - stopTime, 0), 0.05)
        local phase2Start = tick()

        -- Fase 2: espera entrar no Delay Radius
        while not cancelled and Steal.AutoStealEnabled do
            if tick() - phase2Start >= phase2Timeout then cancelled = true; break end
            if not prompt.Parent or not prompt.Parent.Parent then cancelled = true; break end
            local r = root
