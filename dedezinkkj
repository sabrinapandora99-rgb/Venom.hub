local function getActiveMoveSpeed()
    -- Motor do MysteryDuels: Auto Left/Right usam sempre Speed Normal.
    -- O modo Carry/Lagger escolhido continua ligado e volta a valer
    -- assim que o movimento automatico termina.
    if autoLeftEnabled or autoRightEnabled then
        return tonumber(NS) or 59.5
